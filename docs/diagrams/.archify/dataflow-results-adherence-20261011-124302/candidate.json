  "cards": [
    {
      "dot": "emerald",
      "title": "Implemented: Dziennik (ADR-24)",
      "items": [
        "Week rows from the first logged result, max 12 months back",
        "Day = done / planned / missed / off plan; km summed from results in km",
        "Frontend only: reuses GET /results and per-month GET /plans"
      ]
    },
    {
      "dot": "amber",
      "title": "Implemented: training sessions (ADR-25)",
      "items": [
        "results.details = ordered [{label, value}] keyed by the persona's plan columns",
        "Same column shape as plan_items rows, so plan vs done can later compare row by row",
        "metric / value / unit stay required, so existing charts keep working"
      ]
    }
  ]
