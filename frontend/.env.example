# Copy to frontend/.env.local and fill in real values.
# NEVER commit .env.local with real secrets.

# Local: email/password (no Supabase). Production (Vercel): disable and set Supabase + OAuth.
VITE_ENABLE_DEV_LOGIN=true
VITE_API_BASE_URL=http://localhost:8000

# Required on Vercel/production (Google OAuth). Locally with VITE_ENABLE_DEV_LOGIN=true — not needed.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry: errors only; public variables are embedded during build.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
# Build only; never prefix the auth token with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=fmazurkiewicz
SENTRY_PROJECT=goat-web
