# Copy to frontend/.env.local and fill in real values.
# NEVER commit .env.local with real secrets.

# Local: email/password (no Supabase). Production (Vercel): disable and set Supabase + OAuth.
VITE_ENABLE_DEV_LOGIN=true
VITE_API_BASE_URL=http://localhost:8000

# Required on Vercel/production (Google OAuth). Locally with VITE_ENABLE_DEV_LOGIN=true — not needed.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
