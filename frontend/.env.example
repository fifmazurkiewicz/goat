# Kopiuj do frontend/.env.local i uzupełnij realnymi wartościami.
# NIGDY nie commituj .env.local z prawdziwymi wartościami.

# Lokalnie: email/hasło (bez Supabase). Produkcja (Vercel): wyłącz i ustaw Supabase + OAuth.
VITE_ENABLE_DEV_LOGIN=true
VITE_API_BASE_URL=http://localhost:8000

# Wymagane na Vercel/produkcji (Google OAuth). Lokalnie z VITE_ENABLE_DEV_LOGIN=true — niepotrzebne.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
