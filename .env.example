# Szablon backendu — kopiuj do backend/.env (patrz też backend/.env.example).
# NIGDY nie commituj pliku .env z prawdziwymi wartościami.

ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://postgres:<DB-PASSWORD>@localhost:5432/goat

DEV_AUTH_EMAIL=your-dev-email@example.com
DEV_AUTH_PASSWORD=your-dev-password
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_JWT_SECRET=local-dev-jwt-secret-change-me

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_PLANNER_MODEL=anthropic/claude-sonnet-4.6

# Opcjonalne — domyślnie true (patrz backend/.env.example)
CHAT_LLM_TITLE_ENABLED=true
PLAN_AUTO_HARMONIZE_ON_UPSERT=true

CORS_ORIGINS=http://localhost:3000
