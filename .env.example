# Backend — kopiuj do backend/.env po utworzeniu backendu, uzupełnij realnymi wartościami.
# NIGDY nie commituj pliku .env z prawdziwymi wartościami.

ENVIRONMENT=local

# Supabase — lokalnie: dev project w Supabase Cloud (rekomendowane) albo natywny Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
SUPABASE_URL=https://<twoj-projekt-dev>.supabase.co
SUPABASE_JWKS_URL=https://<twoj-projekt-dev>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_PLANNER_MODEL=anthropic/claude-sonnet-4.6

# CORS — dodaj domenę produkcyjną frontendu gdy powstanie
CORS_ORIGINS=http://localhost:3000
