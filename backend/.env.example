# Backend — kopiuj do backend/.env, uzupełnij realnymi wartościami.
# NIGDY nie commituj pliku .env z prawdziwymi wartościami.
# NIGDY nie wklejaj sekretów do .env.example — tylko placeholdery.

ENVIRONMENT=local

# Lokalny Postgres (bez Supabase poolera)
DATABASE_URL=postgresql+asyncpg://postgres:<DB-PASSWORD>@localhost:5432/goat

# Lokalny login email/hasło — aktywny tylko przy ENVIRONMENT=local.
# Na Render ustaw ENVIRONMENT=production i poniższe sekcje Supabase (OAuth).
DEV_AUTH_EMAIL=your-dev-email@example.com
DEV_AUTH_PASSWORD=your-dev-password
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_JWT_SECRET=local-dev-jwt-secret-change-me

# Supabase Cloud — wymagane na Render/produkcji (OAuth + JWKS). Lokalnie opcjonalne.
# SUPABASE_URL i SUPABASE_SERVICE_ROLE_KEY używa też skrypt importu katalogu
# (scripts/import_free_exercise_db.py --upload-photos) — tylko z env, nigdy w commicie.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
# Jeden model do czatu i planowania (Grok). PLANNER pusty = ten sam co CHAT.
OPENROUTER_CHAT_MODEL=x-ai/grok-4-fast
OPENROUTER_PLANNER_MODEL=

# Chat / plany (opcjonalne — domyślnie włączone)
CHAT_LLM_TITLE_ENABLED=true
PLAN_AUTO_HARMONIZE_ON_UPSERT=true
# SSE whole-turn timeout (Goat + consults). Per LLM round: CHAT_ROUND_TIMEOUT_S.
CHAT_HARD_TIMEOUT_S=210
CHAT_ROUND_TIMEOUT_S=90
