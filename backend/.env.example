# Backend — kopiuj do backend/.env, uzupełnij realnymi wartościami.
# NIGDY nie commituj pliku .env z prawdziwymi wartościami.
# NIGDY nie wklejaj sekretów do .env.example — tylko placeholdery.

ENVIRONMENT=local

# Supabase Cloud — Connection pooling / Supavisor, Transaction, port 6543.
# Prefiks postgresql+asyncpg. <ref> = Project Settings → General → Reference ID.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<DB-PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_PLANNER_MODEL=anthropic/claude-sonnet-4.6

# CORS — na Render ustaw https://goat.fmazurkiewicz.dev (lub tymczasowo URL z Vercel)
CORS_ORIGINS=http://localhost:3000
