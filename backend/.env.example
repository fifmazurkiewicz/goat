# Backend — copy to backend/.env and fill in real values.
# NEVER commit a .env with real secrets.
# NEVER paste secrets into .env.example — placeholders only.

ENVIRONMENT=local

# Local Postgres (no Supabase pooler)
DATABASE_URL=postgresql+asyncpg://postgres:<DB-PASSWORD>@localhost:5432/goat

# Local email/password login — active only when ENVIRONMENT=local.
# On Render set ENVIRONMENT=production and the Supabase block below (OAuth).
DEV_AUTH_EMAIL=your-dev-email@example.com
DEV_AUTH_PASSWORD=your-dev-password
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_JWT_SECRET=local-dev-jwt-secret-change-me

# Supabase Cloud — required on Render/production (OAuth + JWKS). Optional locally.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are also used by the catalog import
# (scripts/import_free_exercise_db.py --upload-photos) — from env only, never committed.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
# One model for chat and planning (Grok). Empty PLANNER = same as CHAT.
OPENROUTER_CHAT_MODEL=x-ai/grok-4-fast
OPENROUTER_PLANNER_MODEL=
OPENROUTER_CHAT_MODEL_FALLBACKS=openai/gpt-5-mini
OPENROUTER_PROVIDER_SORT=throughput

# Langfuse Cloud observability (optional; full coaching traces when both keys are set).
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=production
# LANGFUSE_RELEASE=git-sha-or-version

# Chat / plans (optional)
# Keep title generation deterministic so it cannot compete with the foreground answer.
CHAT_LLM_TITLE_ENABLED=false
PLAN_AUTO_HARMONIZE_ON_UPSERT=true
# SSE whole-turn timeout (Goat + consults). Per LLM round: CHAT_ROUND_TIMEOUT_S.
CHAT_HARD_TIMEOUT_S=210
CHAT_ROUND_TIMEOUT_S=90
CHAT_MODERATION_TIMEOUT_S=5

# Privacy retention (days)
PRIVACY_CHAT_RETENTION_DAYS=365
PRIVACY_COMPLETED_JOB_RETENTION_DAYS=30
PRIVACY_MODERATION_SNIPPET_RETENTION_DAYS=90

CORS_ORIGINS=http://localhost:3000

# Auto-approve on first profiles insert only (ADR-22). Sole admin is always included.
ADMIN_EMAILS=fmazurkiewicz@gmail.com
